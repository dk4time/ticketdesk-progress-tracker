# MongoDB Atlas connection string, including the database name, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ticketdesk_progress
MONGODB_URI=

# Shared PIN gating the whole app (checklist + trainer dashboard). Change
# this once the app is reachable over the internet rather than LAN-only.
PROGRESS_TRACKER_PIN=060702

# Must match GRADING_KEY in the TicketDesk repo's grading/config.js on every
# student's machine, or POST /api/verify rejects every report with 401.
GRADING_KEY=tdsk-grading-8f3ac1e9b7d24f0a91c6e5b2d7a1f4c8

# express-session cookie signing secret. Leave unset for local dev (a random
# one is generated at boot); set an explicit value in production so logins
# survive a server restart instead of invalidating every session.
SESSION_SECRET=
